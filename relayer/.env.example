# Injective network: mainnet | testnet
NETWORK=mainnet

# ZEC/USDT perp market to execute against (Injective mainnet)
MARKET_ID=0xef0dd633da52cfc21db866b05463c8b43c02265b86bf9257a5d39848cd2eea11
# Quote token decimals for the market (USDT = 6)
QUOTE_DECIMALS=6

# Batch / reveal window in ms (orders sealed within a window execute together)
REVEAL_WINDOW_MS=15000

# HTTP server
PORT=8888
# CORS origin of the app (the DEX URL), or * for any
CORS_ORIGIN=*

# DRY_RUN=true verifies + batches + "executes" sealed orders WITHOUT broadcasting
# to Injective. This lets you run the full seal -> reveal -> execute lifecycle
# with no funds. Set to false only with a funded omnibus key (below).
DRY_RUN=true

# Omnibus relayer account (only used when DRY_RUN=false).
# Private key hex WITHOUT 0x prefix. SECURITY: use a dedicated hot key holding
# only the USDT you are willing to pool; anyone with this key controls the pool.
RELAYER_PRIVATE_KEY=
# Subaccount index of the omnibus (0 = the relayer address' default subaccount)
RELAYER_SUBACCOUNT_INDEX=0

# On-chain commitment anchor: none | memo
# memo broadcasts a self-transfer whose tx memo carries the commitment, giving a
# public, timestamped, tamper-evident record that the order existed pre-reveal.
# (CosmWasm-contract anchoring is testnet-only; see contracts/anchor.)
ANCHOR_MODE=none
