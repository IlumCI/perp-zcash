# Production configuration for ZEC Perps (Injective mainnet).
# Copy to .env for a production build. VITE_* values are inlined at build time,
# so set them before `yarn build` (or pass as Docker --build-arg).

# --- Identity ---
VITE_NAME=ZEC Perps
# Public URL of your deployment (used for meta/OG/sitemap; must be absolute)
VITE_BASE_URL=https://your-domain.example

# --- Network: mainnet is where the real ZEC/USDT perp lives ---
VITE_NETWORK=mainnet
VITE_CHAIN_ID=injective-1
VITE_ETHEREUM_CHAIN_ID=1
# Use the local vendored injective-ui layer (recommended for reproducible builds)
LOCAL_LAYER=true

# --- Fee revenue (how the venue earns) ---
# Your Injective address receives the builder share of trading fees. Requires
# using your own (non-public) endpoints below; with the default public endpoints
# the community spend pool receives that share instead.
VITE_FEE_RECIPIENT=
VITE_FEE_PAYER_PUB_KEY=

# --- Endpoints (leave blank to use Injective public defaults) ---
# Set your own for reliability + to direct the fee share to VITE_FEE_RECIPIENT.
VITE_INDEXER_API_ENDPOINT=
VITE_SENTRY_GRPC_ENDPOINT=
VITE_SENTRY_REST_ENDPOINT=
VITE_EXPLORER_API_ENDPOINT=
VITE_CHRONOS_API_ENDPOINT=

# --- Flags ---
VITE_MAINTENANCE_DISABLED=false
VITE_VPN_CHECKS_ENABLED=false
VITE_GEO_IP_RESTRICTIONS_ENABLED=false

# --- Shielded order flow ---
# local  = client-side commit-reveal, no relayer, self-custody (safe default).
# relayer= sealed to the relayer for batched/omnibus execution (see relayer/).
#          Do NOT point at a custodial omnibus holding real funds until audited.
VITE_SHIELDED_ENABLED=true
VITE_SHIELDED_MODE=local
VITE_RELAYER_URL=
VITE_SHIELDED_REVEAL_WINDOW_MS=15000

# --- Optional analytics / keys (safe to leave blank) ---
VITE_GOOGLE_ANALYTICS_KEY=
VITE_ALCHEMY_KEY=
VITE_COINGECKO_API_KEY=
